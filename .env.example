# Optional. Add a Gemini API key to enable natural, conversational answers.
# Keep this key on the server; never use a VITE_ prefix for it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Production server port (defaults to 3000).
PORT=3000

# ── Contact form email delivery (Nodemailer / SMTP) ──────────────────────────
# Copy these into your actual .env file (local) AND into Vercel → Project →
# Settings → Environment Variables (production), then redeploy.
# For Gmail: enable 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Use port 465 with CONTACT_SMTP_SECURE=true  (SSL)
# Use port 587 with CONTACT_SMTP_SECURE=false (STARTTLS — recommended for Gmail)

CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=your-gmail@gmail.com
CONTACT_SMTP_PASS=your-16-char-app-password
CONTACT_TO_EMAIL=kamelshah2003@gmail.com
